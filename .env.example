# RAVEN Security Assessment Platform - Environment Configuration
# Copy this file to .env and customize for your deployment

# ===========================================
# Application Settings
# ===========================================
APP_NAME=RAVEN
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://raven:raven@localhost:5432/raven
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ===========================================
# Security
# ===========================================
# IMPORTANT: Change this in production! Must be at least 32 characters
SECRET_KEY=change-me-in-production-min-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# ===========================================
# Ollama (Local LLM)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=-1

# ===========================================
# External Tools
# ===========================================
NMAP_PATH=nmap
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=
HTTPX_TIMEOUT=30

# ===========================================
# Vulnerability Intelligence
# ===========================================
NVD_API_KEY=
EPSS_API_URL=https://api.first.org/data/v1/epss
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
MITRE_ATTACK_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json
INTEL_CACHE_TTL_HOURS=24
INTEL_REFRESH_INTERVAL_HOURS=6

# ===========================================
# Celery (Task Queue)
# ===========================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ===========================================
# Policy Engine
# ===========================================
DEFAULT_EXECUTION_LEVEL=L2_CONTROLLED
MAX_CONCURRENT_ASSESSMENTS=5
ASSESSMENT_TIMEOUT_HOURS=24
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ===========================================
# Evidence Storage
# ===========================================
EVIDENCE_STORAGE_PATH=./evidence
EVIDENCE_MAX_SIZE_MB=100
EVIDENCE_RETENTION_DAYS=365

# ===========================================
# Reporting
# ===========================================
REPORT_OUTPUT_PATH=./reports
REPORT_TEMPLATES_PATH=./templates

# ===========================================
# Health Checks
# ===========================================
HEALTH_CHECK_INTERVAL_SECONDS=30
READINESS_TIMEOUT_SECONDS=10

# ===========================================
# Authorization (CRITICAL)
# ===========================================
# Comma-separated list of authorized targets (domains, IPs, CIDR)
# Example: example.com,192.168.1.0/24,10.0.0.1
# RAVEN will ONLY scan targets in this list!
ALLOWED_TARGETS=
